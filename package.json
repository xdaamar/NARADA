{
  "name": "narada",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "NARADA Cognitive Threat Defense System",
  "author": "PUSSIBERAD TNI AD × CODEPOLITAN",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gateway": "node scripts/start-radar-gateway.js",
    "test:e2e": "node scripts/test-e2e-qualification.js",
    "test:sprint5": "node scripts/test-sprint-5-routing.js",
    "test:sprint5.1": "node scripts/test-sprint-5-1-validation.js",
    "test:sprint6": "node scripts/test-sprint-6-radar-discovery.js",
    "test:sprint6.1": "node scripts/test-sprint-6-1-operational.js",
    "test:sprint6.2": "node scripts/test-sprint-6-2-gdelt.js",
    "test:sprint7": "node scripts/test-sprint-7-evidence.js",
    "test:sprint7:idb": "node scripts/test-sprint-7-indexeddb.js",
    "test:sprint7:smoke": "node scripts/test-sprint-7-electron-smoke.js",
    "test:sprint8": "node scripts/test-sprint-8-intelligence.js",
    "test:sprint8:idb": "node scripts/test-sprint-8-indexeddb.js",
    "test:sprint8:smoke": "node scripts/test-sprint-8-electron-smoke.js",
    "test:sprint9": "node scripts/test-sprint-9-acceptance.js",
    "test:sprint9:sqlite": "node scripts/test-sprint-9-sqlite.js",
    "test:sprint9:smoke": "node scripts/test-sprint-9-electron-smoke.js",
    "test:sprint9:core": "node scripts/test-sprint-9-intelligence-core.js",
    "test:sprint10:acquisition": "node scripts/test-sprint-10-acquisition.js",
    "test:youtube:compliance": "node scripts/test-youtube-compliance.js",
    "test:sprint11": "node scripts/test-sprint-11-social-intelligence.js",
    "test:sprint12": "node scripts/test-sprint-12-ui-workspace.js",
    "test:archive": "node scripts/test-archive-intelligence.js",
    "test:cyber": "node scripts/test-cyber-cluster.js",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "electron:build": "tsc -b && vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/d3": "^7.4.3",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "fast-xml-parser": "^5.11.2",
    "framer-motion": "^14.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.pussiberad.narada",
    "productName": "NARADA Cognitive Defense",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/image/Electrified Golden Globe Crest.png"
    }
  }
}
